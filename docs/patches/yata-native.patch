+        if normalized.is_sign_negative() {
+            if value == BOUND {
+                Self::SELL_ALL
+            } else {
+                Self::Sell(value)
+            }
+        } else if value == BOUND {
+            Self::BUY_ALL
+        } else {
+            Self::Buy(value)
+        }
+    }
