+    /// ```
+    fn ohlc4(&self) -> ValueType {
+        (self.high() + self.low() + self.close() + self.open()) * 0.25
+    }
+
+    /// CLV = \[\(close - low\) - \(high - close\)\] / \(high - low\)
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// use roze_ta::prelude::*;
