+        let delta = { 1e-15 };
+
+        println!("{delta}");
+        (0..=BOUND).for_each(|x| {
+            let xx = x as ValueType;
+            assert_eq!(Action::Buy(x), (half_value * 2. * xx).into());
+            assert_eq!(Action::Sell(x), (-half_value * 2. * xx).into());
+
+            #[allow(clippy::suboptimal_flops)]
+            if x > 0 {
+                let y = x - 1;
+                assert_eq!(
+                    Action::Buy(y),
+                    (half_value * 2. * xx - half_value - delta).into()
+                );
+                assert_eq!(
+                    Action::Sell(y),
+                    (-(half_value * 2. * xx - half_value - delta)).into()
+                );
+            }
+        });
+
