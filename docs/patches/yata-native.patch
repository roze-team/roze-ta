+                    .for_each(|(&a, &b)| assert_eq!(a.to_bits(), b.to_bits()));
+
+                let value2 = if ma_length.is_multiple_of(2) {
+                    (slice[ma_length / 2] + slice[ma_length / 2 - 1]) / 2.0
+                } else {
+                    slice[ma_length / 2]
