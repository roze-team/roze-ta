{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaError",
  "type": "object",
  "properties": {
    "code": {
      "$ref": "#/$defs/ErrorCode"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "message"
  ],
  "$defs": {
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_identity",
        "invalid_bar",
        "invalid_time",
        "duplicate_or_unordered_bar",
        "limit_exceeded",
        "unsupported_profile",
        "duplicate_profile",
        "incompatible_snapshot",
        "corrupt_snapshot",
        "encoding_failed",
        "upstream_failure",
        "not_ready",
        "undefined_result",
        "cancelled",
        "timed_out",
        "invalid_parameter",
        "invalid_sample",
        "duplicate_sample",
        "insufficient_data",
        "numerical_failure",
        "incompatible_artifact"
      ]
    }
  }
}
